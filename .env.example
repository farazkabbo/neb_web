SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=   # leave empty (new Resend accounts have one audience)
RESEND_FROM="neb <hello@myneb.si>"
RESEND_REPLY_TO=mynebsi@gmail.com
NEXT_PUBLIC_SITE_URL=https://myneb.si
NEXT_PUBLIC_LAUNCH_VIDEO_URL=
# Launch day (docs/LAUNCH.md): waitlist (default) or open. Open turns "join" into "Get neb".
LAUNCH_MODE=waitlist
NEXT_PUBLIC_APP_URL=https://app.myneb.si
# Clerk → Webhooks → endpoint https://myneb.si/api/clerk-webhook (user.created) → Signing secret.
CLERK_WEBHOOK_SECRET=
# Upstash Redis, shared with the app (the waitlist's 5-an-hour limit). Unset: per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
